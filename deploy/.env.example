# shell-mcp server configuration — every variable, its default, one line each.
# Placeholder values only. Copy to .env and edit; never commit .env.
# *_FILE variants read the value from a file and win over the plain variable
# (one trailing newline is stripped). Prefer them for secrets.

# --- Profile and tools ------------------------------------------------------
# read-only | operator | admin. Tools above the profile are never registered.
SHELL_MCP_PROFILE=read-only
# Comma list of tool names to remove from the profile. Default: none.
SHELL_MCP_DISABLE_TOOLS=

# --- Transport --------------------------------------------------------------
# http | stdio. stdio requires SHELL_MCP_AUTH_MODE=none.
SHELL_MCP_TRANSPORT=http
# Listen address (an IP). Default 127.0.0.1; the reference compose uses 0.0.0.0 inside the container.
SHELL_MCP_BIND=127.0.0.1
# Listen port. Default 8080.
SHELL_MCP_PORT=8080
# MCP endpoint path. Default /mcp.
SHELL_MCP_PATH=/mcp

# --- Authentication ---------------------------------------------------------
# bearer | none. none only for stdio, or HTTP on 127.0.0.1/::1 with ALLOW_UNAUTHENTICATED=true.
SHELL_MCP_AUTH_MODE=bearer
# Bearer token, at least 43 characters (e.g. 32 random bytes, base64url). Prefer the _FILE form.
SHELL_MCP_TOKEN=
# File holding the bearer token. Wins over SHELL_MCP_TOKEN.
SHELL_MCP_TOKEN_FILE=/run/secrets/mcp_token
# Must be true for auth mode none over HTTP. Default false.
SHELL_MCP_ALLOW_UNAUTHENTICATED=false

# --- HTTP hardening ---------------------------------------------------------
# Host header allow-list. Default localhost,127.0.0.1; add the name clients use.
SHELL_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,mcp.example.test
# Browser Origin allow-list. Default empty: requests carrying Origin are refused.
SHELL_MCP_ALLOWED_ORIGINS=
# Honour the first X-Forwarded-For hop for rate limiting; only behind your own proxy. Default false.
SHELL_MCP_TRUST_PROXY=false
# Requests per minute per client IP. Default 120.
SHELL_MCP_RATE_LIMIT_PER_MIN=120

# --- Targets (use EITHER the targets file OR the single-target variables) ---
# YAML file listing targets (name, host, port, user, host_keys, key_file). Default: none.
SHELL_MCP_TARGETS_FILE=
# Single-target shorthand: target name (lowercase letters, digits, - and _).
SHELL_MCP_TARGET_NAME=app-host
# Single-target shorthand: SSH host name or IP.
SHELL_MCP_TARGET_HOST=target-a.example.test
# Single-target shorthand: SSH port. Default 22.
SHELL_MCP_TARGET_PORT=22
# Single-target shorthand: the target's service user.
SHELL_MCP_TARGET_USER=svc-shell
# Comma list of pinned host-key fingerprints (SHA256:<base64>). Required; a list allows rotation.
SHELL_MCP_TARGET_HOST_KEYS=SHA256:placeholder
# Recommended: file holding the unencrypted OpenSSH Ed25519 private key (a mounted secret). Wins over SHELL_MCP_SSH_KEY; the default for targets without key_file.
SHELL_MCP_SSH_KEY_FILE=/run/secrets/ssh_key
# Fallback for env stores: the key as PEM, or as single-line base64 of the whole key file (Linux: base64 -w0 ssh_key; PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("ssh_key"))).
SHELL_MCP_SSH_KEY=
# Target used when a tool call names none (needed only with several targets). Default: none.
SHELL_MCP_DEFAULT_TARGET=

# --- SSH and operation limits -----------------------------------------------
# SSH connect timeout, seconds (1..120). Default 10.
SHELL_MCP_SSH_CONNECT_TIMEOUT=10
# Concurrent SSH sessions per target (1..64). Default 4.
SHELL_MCP_SSH_MAX_SESSIONS=4
# Default gate operation timeout, seconds. Default 30.
SHELL_MCP_DEFAULT_TIMEOUT=30
# Maximum gate operation timeout, seconds; the gate clamps further. Default 300.
SHELL_MCP_MAX_TIMEOUT=300
# Bytes per output stream returned to the client. Default 262144.
SHELL_MCP_MAX_OUTPUT_BYTES=262144

# --- Human approval (D-006) -------------------------------------------------
# destructive | operator,destructive. destructive cannot be removed.
SHELL_MCP_APPROVAL_TIERS=destructive
# deny | confirm-argument. For clients without elicitation; confirm-argument is an explicit, WARN-logged opt-out.
SHELL_MCP_APPROVAL_FALLBACK=deny
# Seconds an approval request stays valid (30..600). Default 120.
SHELL_MCP_APPROVAL_TTL=120

# --- Output and logging -----------------------------------------------------
# Extra RE2 redaction patterns, one per line (a single line is one pattern). Default: none.
SHELL_MCP_REDACT_PATTERNS=
# File with one redaction pattern per line; wins over SHELL_MCP_REDACT_PATTERNS. Use it when your env store cannot hold newlines.
SHELL_MCP_REDACT_PATTERNS_FILE=
# debug | info | warn | error. Default info.
SHELL_MCP_LOG_LEVEL=info
# json | text. Default json. Logs go to stderr.
SHELL_MCP_LOG_FORMAT=json
