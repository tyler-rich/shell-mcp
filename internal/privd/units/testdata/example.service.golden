# Generated by shell-mcp-privd units from /etc/shell-mcp/privileged.yaml — do not edit by hand.
# Policy sha256: 3f2c9b8a7d6e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a
# Core unit (PRIVILEGED §5.1): one request per instance, root with a
# minimal capability set, writes only to the declared paths, no network.
[Unit]
Description=shell-mcp privileged helper (core unit, one request)
Documentation=https://github.com/tyler-rich/shell-mcp/blob/main/docs/PRIVILEGED.md
CollectMode=inactive-or-failed

[Service]
ExecStart=/usr/local/libexec/shell-mcp-privd serve --policy /etc/shell-mcp/privileged.yaml
StandardInput=socket
StandardOutput=socket
StandardError=journal
SyslogIdentifier=shell-mcp-privd
Environment=SHELL_MCP_PRIVD_POLICY_SHA256=3f2c9b8a7d6e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a
Environment=SHELL_MCP_PRIVD_CLIENT_UID=60123
User=root
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_KILL CAP_SYS_BOOT
ProtectSystem=strict
ReadWritePaths=/etc/example-app/conf.d /srv/app/config /etc/systemd/system/example-app.service.d /var/lib/shell-mcp/backups
InaccessiblePaths=-/etc/shadow -/etc/shadow- -/etc/gshadow -/etc/gshadow- -/etc/sudoers -/etc/sudoers.d -/etc/security/opasswd -/etc/ssh -/root/.ssh
ProtectHome=read-only
TemporaryFileSystem=/run:ro
ProtectProc=default
ProcSubset=pid
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @module @swap @raw-io @debug @obsolete
UMask=0077
RuntimeMaxSec=150
TasksMax=64
MemoryMax=256M
