# Broad unit socket (PRIVILEGED §2, §3): one helper instance per connection.
[Unit]
Description=shell-mcp privileged helper socket (broad unit)
Documentation=https://github.com/tyler-rich/shell-mcp/blob/main/docs/PRIVILEGED.md

[Socket]
ListenStream=/run/shell-mcp/privd-broad.sock
Accept=yes
SocketUser=root
SocketGroup=svc-shell-priv
SocketMode=0660
DirectoryMode=0711
MaxConnections=16

[Install]
WantedBy=sockets.target
