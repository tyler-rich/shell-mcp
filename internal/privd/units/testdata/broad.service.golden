# Generated by shell-mcp-privd units from /etc/shell-mcp/privileged.yaml — do not edit by hand.
# Policy sha256: 3f2c9b8a7d6e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a
# Broad unit (PRIVILEGED §5.2): one request per instance, for packages,
# unit: broad commands and power. Network and full root capabilities:
# ROOT-EQUIVALENT by design.
[Unit]
Description=shell-mcp privileged helper (broad unit, one request)
Documentation=https://github.com/tyler-rich/shell-mcp/blob/main/docs/PRIVILEGED.md
CollectMode=inactive-or-failed

[Service]
ExecStart=/usr/local/libexec/shell-mcp-privd serve --policy /etc/shell-mcp/privileged.yaml
StandardInput=socket
StandardOutput=socket
StandardError=journal
SyslogIdentifier=shell-mcp-privd
Environment=SHELL_MCP_PRIVD_POLICY_SHA256=3f2c9b8a7d6e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a
Environment=SHELL_MCP_PRIVD_CLIENT_UID=60123
Environment=SHELL_MCP_PRIVD_UNIT=broad
User=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
RuntimeMaxSec=150
TasksMax=256
MemoryMax=1G
