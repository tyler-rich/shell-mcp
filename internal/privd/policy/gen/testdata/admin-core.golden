# Privileged policy for the invented host target-a.example.test (fixture).
#
# Regenerate the units after every edit: the helper refuses to serve a
# policy whose SHA-256 is not the one its units were generated from. Write
# this file for the worst case: what would you accept a fully compromised
# MCP server doing as root with it? Human approval (D-006) stops a misled
# model, not a compromised server (PRIVILEGED §3).

version: 1

# The gate service account's pinned UID (D-020). Only a peer with this uid
# is served (SO_PEERCRED). Never 0.
client_uid: 60123

# Group of the helper's sockets (root:<group> 0660). It must exist locally;
# the gate's account is its only member. Never root, sudo, docker, ….
socket_group: svc-shell-priv

# Ceiling for every privileged operation: read | operator | destructive.
# priv_delete, priv_pkg_remove and priv_power are destructive.
max_tier: destructive

sandbox:
  # Landlock inside the core unit: required (default) refuses to serve
  # without it; best-effort must be chosen explicitly. The broad unit has
  # no Landlock sandbox (package managers write everywhere).
  landlock: required

limits:
  max_read_bytes: 1048576      # priv_read_file ceiling, ≤ 4 MiB
  max_write_bytes: 1048576     # priv_write_file ceiling, ≤ 1 MiB
  max_output_bytes: 1048576    # per stream for commands and apt, ≤ 4 MiB
  default_timeout_s: 60
  max_timeout_s: 900           # package operations can be slow; ≤ 1800
  max_delete_entries: 1000     # recursive delete ceiling, ≤ 10000
  max_memory_mb: 1024          # RLIMIT_DATA of every command and apt-get, 128..16384;
                               # both units' MemoryMax= is this + 256

paths:
  # Roots root may read. A read root may contain credential files (the deny
  # list and the unit's InaccessiblePaths= keep them out) but may not be
  # inside the never list (PRIVILEGED §5.3 list A).
  read: [/etc/example-app]
  # Roots root may write (implicitly readable); they become the core unit's
  # ReadWritePaths=. Never on or around the never list, never inside .git.
  write: [/etc/example-app/conf.d]
  # Added to the built-in read deny list (POLICY §3).
  deny: ["/srv/app/secrets/**"]

owners:
  # The only users and groups priv_chown, priv_write_file, priv_copy and
  # priv_mkdir may set.
  users: [root]
  groups: [root]

modes:
  # No requested mode may exceed this mask; setuid, setgid, sticky and
  # world-write are never allowed.
  max: "0755"

backups:
  # Previous versions kept per file in /var/lib/shell-mcp/backups (0..100).
  keep: 10
  # Total size of the backup store, data and metadata together (64 MiB to
  # 1 TiB; default 1 GiB). An overwrite or delete whose backup would take
  # the store over it is refused (backup_failed) and changes nothing.
  max_store_bytes: 1073741824

# Commands run as root, matched against argv templates exactly as in the
# gate policy (POLICY §4). A command whose binary is a power, kernel,
# storage or firewall tool (POLICY §5 groups 11–13) needs an acknowledge;
# shells, interpreters, launchers and the like are never allowed.
#
# Core unit (the default): no network, writes only to the roots above,
# Landlock, a four-capability bounding set. A core command may add
# capabilities: CAP_SYS_BOOT, CAP_KILL or (with root_equivalent: true)
# CAP_SYS_ADMIN.
# Broad unit (unit: broad): network and full root capabilities —
# root-equivalent by design, always reported. Only for commands that need
# it. A broad command may also add CAP_SYS_TIME (drops ProtectClock=),
# CAP_NET_ADMIN or CAP_NET_BIND_SERVICE.
commands:
  # Lists block devices as root.
  - id: block-devices
    path: /usr/bin/lsblk
    tier: read
    templates: [["--json"]]
  - id: signal-app
    path: /usr/bin/kill
    tier: operator
    description: "Ask the application to reload its configuration"
    capabilities: [CAP_KILL]
    templates: [["-HUP", "{int:2-4194304}"]]
