# Gate policy for the invented host target-a.example.test (fixture).
#
# Read-only key for the server at 192.0.2.10.
#
# Run `shell-mcp-gate check-policy --policy <this file>` after every edit.
# Write it for the worst case: "what would I accept a fully compromised MCP
# server doing with this key?"

version: 1

# The ceiling for every operation and command. read = no state change.
max_tier: read

# The kernel sandbox (Landlock + no_new_privs + a seccomp filter for MPTCP),
# applied before the request is read and inherited by every child.
sandbox:
  # required (the default) refuses to serve when the kernel cannot enforce
  # the rules (Landlock ABI 4 or newer is needed). best-effort serves with
  # reduced enforcement and says so in hello and check-policy.
  landlock: best-effort
  # Extra read+execute directories for declared binaries. /usr, /bin, /sbin
  # and /lib* are always granted; never add a writable directory here.
  system_read_exec: []
  # TCP ports children may connect to. Git pulls need the remote's port
  # (443); a read-only key needs none. There is never a TCP bind.
  tcp_connect_ports: []

# Omitted limits take the defaults shown in docs/POLICY.md §1.
limits:
  max_output_bytes: 262144
  max_read_bytes: 1048576
  max_processes: 2000
  # The memory limit (RLIMIT_DATA) of every command and git process, in MiB:
  # 128..16384, 1024 when omitted (measured to fit these commands).
  max_memory_mb: 1024

paths:
  # Read roots. /, /proc, /sys, /dev and /run can never be roots.
  read: [/srv/app, /var/log/example-app]
  # Added to the built-in deny list (keys, shadow, .ssh, ...), which cannot
  # be removed.
  deny: ["**/*.key"]

journal:
  # Units whose journal is readable; the service account needs the
  # systemd-journal group for other units' messages.
  units: ["example-app.service"]
  max_lines: 1000

# Redaction patterns (RE2) applied to every output, on top of the built-in
# private-key, Authorization and Bearer rules.
redact:
  patterns: ['(?i)(api[_-]?key|token|secret|password)\s*[:=]\s*\S+']
