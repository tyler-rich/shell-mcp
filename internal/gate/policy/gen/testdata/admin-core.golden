# Admin answers whose privileged policy uses the core unit only, so the
# gate's forwarding has no broad_socket. Every value is invented.
#
# Run `shell-mcp-gate check-policy --policy <this file>` after every edit.
# Write it for the worst case: "what would I accept a fully compromised MCP
# server doing with this key?"

version: 1

# destructive = delete paths, discard git working-tree changes, and
# destructive policy commands.
max_tier: destructive

sandbox:
  landlock: required
  system_read_exec: []
  tcp_connect_ports: [443]

limits:
  max_timeout_s: 600
  max_delete_entries: 1000

paths:
  read: [/srv/app]
  deny: ["/srv/app/secrets/**"]

git:
  repos:
    - path: /srv/app/deploy
      remote: https://git.example.test/org/deploy.git

# Forwarding of priv_* operations to the privileged helper. The helper's
# own policy decides what root may do; this only enables asking it, and
# caps the tier. The sockets are always under /run/shell-mcp/: the core
# unit's, and the broad unit's for package operations, power and commands
# the privileged policy declares unit: broad (omit broad_socket if the
# helper has no broad unit).
privileged:
  enabled: true
  socket: /run/shell-mcp/privd.sock
  max_tier: operator

redact:
  patterns: ['(?i)(api[_-]?key|token|secret|password)\s*[:=]\s*\S+']
