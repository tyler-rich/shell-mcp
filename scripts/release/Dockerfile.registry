# The loopback registry the release workflow pushes the images to inside a
# job (127.0.0.1 only, no volume, removed with the job), so that the
# multi-platform index can be built, verified and signed in a dry run without
# publishing anything. It is never built: the workflow runs this FROM line's
# image, and this file exists so that Dependabot keeps its digest current and
# deps-current its version (D-013).
FROM registry:3.1.2@sha256:38907510915c3f1604c7e83d6ab602ab3020d092f73bdaed8696773693ff768c
